# HTML keeps Cloudflare's default (revalidate every visit) so deploys show at once.

# Never edited in place: rename the file (or bump the version folder) to change it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/piixpal/0.4.0/*
  Cache-Control: public, max-age=31536000, immutable

# Media may be regenerated under the same name, so cache for a week.
/assets/*
  Cache-Control: public, max-age=604800
