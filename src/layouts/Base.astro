---
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import LanguageHistory from "../components/LanguageHistory.astro";
import LanguageMotion from "../components/LanguageMotion.astro";
import FooterRoomba from "../components/FooterRoomba.astro";

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = "Ryo Kato",
  description = title === "Ryo Kato"
    ? "Ryo Kato’s personal website — mechanical engineering, robotics, projects, and interests."
    : `${title} — Ryo Kato’s personal website.`,
  activeNav,
} = Astro.props;

const currentLocale = Astro.currentLocale || 'en';
const fullTitle = title === "Ryo Kato" ? title : `${title} — Ryo Kato`;

const navLabels: Record<string, Record<string, string>> = {
  en: { home: "home", interests: "interests" },
  ja: { home: "ホーム", interests: "興味" },
};

const nav = [
  { href: `/${currentLocale}/`, key: "home" },
  { href: `/${currentLocale}/interests`, key: "interests" },
].map(link => ({
  ...link,
  label: navLabels[currentLocale][link.key]
}));
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={currentLocale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        let stored;
        try { stored = localStorage.getItem("theme"); } catch {}
        const preferred =
          (stored === "nord-dark" || stored === "nord-light" ? stored : null) ||
          "nord-light";
        document.documentElement.setAttribute("data-theme", preferred);
      })();
    </script>
    <LanguageHistory />
    <LanguageMotion />
  </head>
  <body>
    <div class="mx-auto max-w-2xl">
      <!-- Nav: just links + theme toggle, no name -->
      <nav class="mb-12 flex items-center justify-between">
        <ul class="flex flex-wrap gap-x-4 gap-y-1 list-none p-0 m-0">
          {
            nav.map(({ href, key, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={activeNav === key ? "page" : undefined}
                  class:list={[
                    "font-mono text-xs tracking-widest lowercase no-underline transition-colors",
                    activeNav === key
                      ? "text-text underline underline-offset-[3px]"
                      : "text-subtext0 hover:text-text",
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-3">
          <LanguagePicker currentLocale={currentLocale} />
        
        </div>
      </nav>

      <!-- Main content -->
      <main>
        <slot />
      </main>

      <!-- Footer -->
      <footer
        class="mt-24 pt-2 border-t border-surface0 font-mono text-xs text-subtext0 flex items-center justify-between"
      >
        <span>© {new Date().getFullYear()} Ryo Kato</span>

      <button
          id="theme-toggle"
          class="theme-toggle bg-transparent p-0 outline-none border-none cursor-pointer"
          aria-label="Switch theme"
        >
          <!-- Sun Icon (shown in dark mode to switch to light) -->
          <svg id="sun-icon" aria-hidden="true" class="w-5 h-5 text-text" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 1.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0V2a.75.75 0 0 1 .75-.75M1.25 12a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5H2a.75.75 0 0 1-.75-.75m19 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75M12 20.25a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1a.75.75 0 0 1 .75-.75" clip-rule="evenodd" />
  <path fill="currentColor" d="M4.398 4.398a.75.75 0 0 1 1.061 0l.393.393a.75.75 0 0 1-1.06 1.06l-.394-.392a.75.75 0 0 1 0-1.06m15.202 0a.75.75 0 0 1 0 1.06l-.392.393a.75.75 0 0 1-1.06-1.06l.392-.393a.75.75 0 0 1 1.06 0m-1.453 13.748a.75.75 0 0 1 1.061 0l.393.393a.75.75 0 0 1-1.06 1.06l-.394-.392a.75.75 0 0 1 0-1.06m-12.295 0a.75.75 0 0 1 0 1.06l-.393.393a.75.75 0 1 1-1.06-1.06l.392-.393a.75.75 0 0 1 1.06 0"  clip-rule="evenodd"/>
          </svg>
          <!-- Moon Icon (shown in light mode to switch to dark) -->
          <svg id="moon-icon" aria-hidden="true" class="w-5 h-5 text-text" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 22c5.523 0 10-4.477 10-10c0-.463-.694-.54-.933-.143a6.5 6.5 0 1 1-8.924-8.924C12.54 2.693 12.463 2 12 2C6.477 2 2 6.477 2 12s4.477 10 10 10"/>
          </svg>
        </button>
        <FooterRoomba />
      </footer>
    </div>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const html = document.documentElement;

      function getTheme() {
        return html.getAttribute("data-theme") || "nord-light";
      }
      function applyTheme(theme: string) {
        html.setAttribute("data-theme", theme);
        try { localStorage.setItem("theme", theme); } catch {}
        updateThemeLabel(theme);
      }

      function updateThemeLabel(theme: string) {
        toggle?.setAttribute("aria-label", theme === "nord-dark" ? "Switch to light theme" : "Switch to dark theme");
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let themeTimer: ReturnType<typeof setTimeout> | undefined;
      function finishThemeTransition() {
        clearTimeout(themeTimer);
        html.classList.remove('theme-switching');
      }
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) finishThemeTransition();
      });
      window.addEventListener('pagehide', finishThemeTransition);
      window.addEventListener('pageshow', finishThemeTransition);
      updateThemeLabel(getTheme());
      toggle?.addEventListener("click", () => {
        clearTimeout(themeTimer);
        if (!reducedMotion.matches) {
          html.classList.add('theme-switching');
          themeTimer = setTimeout(finishThemeTransition, 280);
        }
        applyTheme(getTheme() === "nord-light" ? "nord-dark" : "nord-light");
      });
    </script>
  </body>
</html>
