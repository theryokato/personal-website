---
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import { socials } from "../constants/socials";
interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  image?: string;
}
const ja = Astro.url.pathname.startsWith("/ja");
const lang = ja ? "ja" : "en";
const {
  title = "Ryo Kato",
  description = ja
    ? "加藤遼の機械設計、ロボット制御、航空宇宙分野での活動記録。"
    : "Engineering projects and technical experience of Ryo Kato, a mechanical engineering undergraduate at Texas A&M.",
  activeNav,
  image = "/assets/previews/dron-prototype.jpg.960.webp",
} = Astro.props;
const name = ja ? "加藤 遼" : "Ryo Kato";
const fullTitle =
  title === name
    ? name + " | " + (ja ? "機械工学" : "Mechanical Engineering")
    : title + " | " + name;
const origin = "https://theryokato.com";
const path = Astro.url.pathname.replace(/\/?$/, "/");
const missing = title.startsWith("404");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {missing ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={origin + path} />
        {["en", "ja"].map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={origin + path.replace(/^\/(en|ja)/, "/" + l)}
          />
        ))}
      </>
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={origin + path} />
    <meta property="og:image" content={origin + image} />
    <meta property="og:locale" content={ja ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" />
    {activeNav === "home" && !missing && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          name: "Ryo Kato",
          alternateName: "加藤 遼",
          url: origin + path,
          affiliation: {
            "@type": "CollegeOrUniversity",
            name: "Texas A&M University",
          },
          sameAs: socials
            .filter((s) => s.platform !== "Email")
            .map((s) => s.href),
        })}
      />
    )}
    <script is:inline>
      let theme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "nord-dark"
        : "nord-light";
      try {
        const saved = localStorage.getItem("theme");
        if (["nord-dark", "nord-light"].includes(saved)) theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {ja ? "本文へ" : "Skip to content"}
    </a>
    <header class="mast wrap">
      <a class="signature" href={"/" + lang + "/"}>
        <i aria-hidden="true"></i> Ryo Kato<span lang="ja">加藤 遼</span>
      </a>
      <nav aria-label={ja ? "メインメニュー" : "Main navigation"}>
        <a
          aria-current={activeNav === "projects" ? "page" : undefined}
          href={"/" + lang + "/projects/"}
        >
          {ja ? "プロジェクト" : "Projects"}
        </a>
        <a href={"/" + lang + "/#experience"}>{ja ? "活動歴" : "Experience"}</a>
      </nav>
      <div class="settings">
        <LanguagePicker currentLocale={lang} />
        <button
          id="theme-toggle"
          aria-label={ja ? "ダークモード" : "Dark mode"}
          title={ja ? "配色を切り替える" : "Change theme"}
        >
          ◐
        </button>
      </div>
    </header>
    <main
      id="main"
      tabindex="-1"
      class:list={["wrap", { secondary: activeNav === "interests" || missing }]}
    >
      <slot />
    </main>
    <footer class="wrap foot">
      <span>© {new Date().getFullYear()} Ryo Kato</span>
      <a href={"/" + lang + "/interests/"}>
        {ja ? "趣味" : "Personal interests"}
      </a>
      <a href="/pgp">PGP</a>
      {socials
        .filter((s) => s.platform !== "Email")
        .map((s) => (
          <a href={s.href}>{s.platform}</a>
        ))}
      <a href="mailto:contact@theryokato.com">contact@theryokato.com</a>
    </footer>
    <script>
      const root = document.documentElement,
        toggle = document.getElementById("theme-toggle");
      const sync = () =>
        toggle?.setAttribute(
          "aria-pressed",
          String(root.dataset.theme === "nord-dark"),
        );
      sync();
      toggle?.addEventListener("click", () => {
        root.dataset.theme =
          root.dataset.theme === "nord-dark" ? "nord-light" : "nord-dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
        sync();
      });
    </script>
  </body>
</html>
