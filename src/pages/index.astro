---
import Base from '../layouts/Base.astro';

/*
const projectModules = import.meta.glob('../content/projects/*.mdx', { eager: true }) as Record<string, any>;
const recentProjects = Object.values(projectModules)
  .map((p: any) => p.frontmatter)
  .sort((a: any, b: any) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 2);
*/
const recentProjects = [];


import NavList from '../components/NavList.astro';
const currentPath = Astro.url.pathname;

const sections = [
  { title: 'projects',  description: 'Things I have worked on.',           href: '/projects',     active: currentPath.startsWith('/notes')     },
  { title: 'interests',    description: 'Stuff I like.', href: '/interests',  active: currentPath.startsWith('/projects')  },
  { title: 'about me',    description: 'Who am I?', href: '/aboutme', active: currentPath.startsWith('/bookshelf') },
];
---

<Base title="Your Name" activeNav="home">
  <section class="mb-1">

    <!-- Big name heading -->
    <h1
      id="hero-name"
      class="text-2xl sm:text-4xl font-normal leading-none tracking-tight text-text mb-6 transition-all duration-200"
    >
      Howdy, I'm Ryo Kato
    </h1>
    <!-- Social icons row -->
    <div class="flex items-center gap-4 mb-2 mt-0">
      <!-- GitHub -->
      <a
        href="https://github.com/theryokato"
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-texttransition-colors no-underline"
        data-handle="@theryokato"
        aria-label="GitHub"
      >
        <svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/ryokato-texasam"
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
        data-handle="/in/ryokato-texasam"
        aria-label="LinkedIn"
      >
        <svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <!-- Read.cv or similar -->
      <a
        href="https://read.cv/yourname"
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
        data-handle="yourname"
        aria-label="Read.cv"
      >
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z"/>
        </svg>
      </a>
    </div>
    <!-- Bio -->
    <p class="mb-4 text-text text-lg leading-relaxed">
      I'm a third-year mechanical engineering student at <a href="https://www.tamu.edu" class="text-text underline underline-offset-[3px] decoration-1 hover:text-maroon transition-colors">Texas A&M University</a>.
	  Currently the Internal VP of <a href="https://turtlerobotics.org" class="text-text underline underline-offset-[3px] decoration-1 hover:text-yellow transition-colors">TURTLE Robotics</a>, the largest student-led robotics org in Texas. Also helping out research at <a href="https://herc.engr.tamu.edu/" class="text-text underline underline-offset-[3px] decoration-1 hover:text-peach transition-colors">Human-Empowering Robotics and Control (HERC) Lab</a>.
	  <br /><br />
	  something something 
    </p>
    <!-- <p class="mb-0 text-[var(--color-subtext1)] leading-relaxed">
      Interested in making tools, thoughtful interfaces, and the craft of software.
    </p> -->
  </section>

  
  

  <!-- {recentProjects.length > 0 && (
    <section>
      <h2 class="text-lgfont-mono text-[var(--color-text)] uppercase tracking-widest mb-6 font-normal">
        Recent projects
      </h2>
      <div class="grid grid-cols-2 gap-4">
        {recentProjects.map((proj: any) => (
          <a
            href={`/projects/${proj.slug}`}
            class="group no-underline block rounded-sm overflow-hidden border border-[var(--color-subtext0)] hover:border-[var(--color-surface2)] transition-colors"
          >
            <div class="overflow-hidden bg-[var(--color-mantle)] aspect-[16/10]">
              {proj.image
                ? <img src={proj.image} alt={proj.title} class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" />
                : <div class="w-full h-full bg-[var(--color-surface0)]" />
              }
            </div>
            <div class="p-1">
              <p class="text-sm font-normal text-[var(--color-text)] m-0 leading-snug">{proj.title}</p>
              {/* {proj.description && (
                <p class="text-xs text-[var(--color-subtext0)] mt-1 m-0 leading-snug line-clamp-2">{proj.description}</p>
              )} */}
            </div>
          </a>
        ))}
		
      </div>
    </section>
  )} -->

  <NavList items={sections} />
</Base>

<script>
  // On hover of any .social-icon, replace the h1 text temporarily
  const h1 = document.getElementById('hero-name');
  const originalText = h1?.textContent ?? '';

  document.querySelectorAll('.social-icon').forEach(icon => {
    const handle = (icon as HTMLElement).dataset.handle ?? '';
    // const platform = (icon as HTMLElement).getAttribute('aria-label') ?? '';

    icon.addEventListener('mouseenter', () => {
      if (h1) {
        h1.textContent = `${handle}`;
        // h1.style.color = 'var(--color-text)';
      }
    });
    icon.addEventListener('mouseleave', () => {
      if (h1) {
        h1.textContent = originalText;
        // h1.style.color = '';
      }
    });
  });
</script>