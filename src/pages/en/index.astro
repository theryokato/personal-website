---
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { socials } from "../../constants/socials";
import { homeContent } from "../../content/home/en";

---

<Base title={homeContent.name} activeNav="home">
  <section class="mb-1">
    <p
      id="hero-name"
      class="mb-4 text-text text-lg font-bold leading-relaxed transition-opacity duration-200"
    >
      {homeContent.name}
    </p>

    <!-- Bio -->
    <p class="mb-4 text-text text-lg leading-relaxed" set:html={homeContent.bio} />
  </section>

  <!-- Social icons row -->
  <div class="flex items-center gap-3 mb-2 mt-0">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
        data-handle={social.handle}
        aria-label={social.platform}
      >
        <svg
          width="25"
          height="25"
          viewBox={social.viewBox}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={social.svgPath}></path>
        </svg>
      </a>
    ))}
  </div>

  <br />

  <section id="projects" aria-labelledby="projects-heading">
    <div class="py-3">
      <h2 id="projects-heading" class="block text-lg font-normal text-text leading-snug">
        {homeContent.sections[0].title}
      </h2>
      <p class="block text-sm text-subtext0 leading-snug mt-0.5">
        {homeContent.sections[0].description}
      </p>
    </div>
    <ProjectGrid locale="en" />
  </section>
</Base>
