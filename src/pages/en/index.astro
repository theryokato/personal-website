---
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { socials } from "../../constants/socials";
import { homeContent } from "../../content/home/en";

---

<Base title={homeContent.name} activeNav="home">
  <section class="mb-1">
    <h1
      id="hero-name"
      class="mb-4 text-text text-2xl font-semibold leading-[1.95rem] whitespace-nowrap transition-opacity duration-200"
    >
      {homeContent.name}
    </h1>

    <!-- Bio -->
    {homeContent.bio.map(paragraph => (
      <p class="mb-4 text-text text-lg leading-relaxed" set:html={paragraph} />
    ))}
  </section>

  <!-- Social icons row -->
  <div class="flex items-center gap-3 mt-0">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
        data-handle={social.handle}
        aria-label={social.platform}
      >
        <svg
          width="25"
          height="25"
          viewBox={social.viewBox}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={social.svgPath}></path>
        </svg>
      </a>
    ))}
  </div>

  <section id="projects" class="mt-12" aria-label={homeContent.sections[0].title}>
    <ProjectGrid locale="en" />
  </section>
</Base>

<script src="../../scripts/social-name.ts"></script>
<script src="../../scripts/copy-email.ts"></script>
