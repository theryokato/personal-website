---
import Base from '../../../layouts/Base.astro';
import MediaList from '../../../components/MediaList.astro';
import { InterestService } from '../../../services/interests';

const items = await InterestService.getMovies('en');

---

<Base title="Movies" activeNav="interests">
  <h1 class="text-[1.75rem] font-normal leading-tight tracking-tight text-text mb-2">
    Movies
  </h1>
  <p class="font-mono text-xs text-subtext0 mb-10">
    Good weekend watch after a tiring week
  </p>

  {items?.length ? <MediaList items={items} /> : <p>This list is currently unavailable.</p>}
</Base>
