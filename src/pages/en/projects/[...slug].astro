---
import { preview, previewSet } from "../../../utils/previews";
import Base from "../../../layouts/Base.astro";
import { formatDate } from "../../../utils/dates";
import NextProject from "../../../components/NextProject.astro";

export async function getStaticPaths() {
    const modules = import.meta.glob("../../../content/projects/en/*.mdx", {
        eager: true,
    }) as Record<string, any>;
    const projects = Object.values(modules);

    const projectPaths = projects
        .filter((proj: any) => !proj.frontmatter.url)
        .map((proj: any) => ({
            params: { slug: proj.frontmatter.slug },
            props: { proj },
        }));

    return projectPaths;
}

const { proj } = Astro.props as any;
const Content = proj.Content;
---

<Base
    title={proj.frontmatter.title}
    description={proj.frontmatter.description}
>
    <a
        href="/en/#projects"
        class="font-mono text-xs text-subtext0 hover:text-text no-underline mb-8 inline-block transition-colors"
    >
        &larr; projects
    </a>
    {proj.frontmatter.image && (
        <div class="mb-8 rounded-sm overflow-hidden border border-surface0 aspect-16/7" data-project-media={proj.frontmatter.slug}>
            <img
                src={preview(proj.frontmatter.image)} srcset={previewSet(proj.frontmatter.image)} sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 45rem) calc(100vw - 3rem), 42rem" fetchpriority="high" decoding="async"
                alt={proj.frontmatter.title}
                class="w-full h-full object-cover"
            />
        </div>
    )}

    <article>
        <header class="mb-8">
            <h1 class="text-[1.875rem] font-medium leading-tight tracking-[-0.01em] text-text mb-2">
                {proj.frontmatter.title}
            </h1>
            <div class="flex flex-wrap items-center gap-3 font-mono text-xs leading-[1.5] text-subtext0">
                <span>
                    {formatDate(proj.frontmatter.startDate)}
                    {" — "}
                    {formatDate(proj.frontmatter.endDate)}
                </span>
            </div>
        </header>
        <div class="prose">
            <Content />
        </div>
    </article>
    <NextProject locale="en" slug={proj.frontmatter.slug} />
</Base>
