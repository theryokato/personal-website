---
import Base from "../../layouts/Base.astro";
import NavList from "../../components/NavList.astro";
import { socials } from "../../constants/socials";
import { homeContent } from "../../content/home/ja";

const currentPath = Astro.url.pathname;

const sections = homeContent.sections.map(section => ({
  ...section,
  active: currentPath.startsWith(section.href),
}));
---

<Base title={homeContent.name} activeNav="home">
  <section class="mb-1">
    <p
      id="hero-name"
      class="mb-4 text-text text-lg font-bold leading-relaxed transition-opacity duration-200"
    >
      {homeContent.name}
    </p>

    <!-- Bio -->
    <p class="mb-4 text-text text-lg leading-relaxed" set:html={homeContent.bio} />
  </section>

  <!-- Social icons row -->
  <div class="flex items-center gap-3 mb-2 mt-0">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener"
        class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
        data-handle={social.handle}
        aria-label={social.platform}
      >
        <svg
          width="25"
          height="25"
          viewBox={social.viewBox}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={social.svgPath}></path>
        </svg>
      </a>
    ))}
  </div>

  <br />

  <NavList items={sections} />
</Base>

<script>
  // On hover of any .social-icon, replace the name text temporarily with a fade effect
  const nameElement = document.getElementById("hero-name");
  const originalText = nameElement?.textContent ?? "";

  document.querySelectorAll(".social-icon").forEach((icon) => {
    const handle = (icon as HTMLElement).dataset.handle ?? "";

    icon.addEventListener("mouseenter", () => {
      if (nameElement) {
        nameElement.style.opacity = "0";
        setTimeout(() => {
          nameElement.textContent = handle;
          nameElement.style.opacity = "1";
        }, 150);
      }
    });
    icon.addEventListener("mouseleave", () => {
      if (nameElement) {
        nameElement.style.opacity = "0";
        setTimeout(() => {
          nameElement.textContent = originalText;
          nameElement.style.opacity = "1";
        }, 150);
      }
    });
  });
</script>
