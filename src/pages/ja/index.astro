---
import Base from "../../layouts/Base.astro";

/*
const projectModules = import.meta.glob('../content/projects/*.mdx', { eager: true }) as Record<string, any>;
const recentProjects = Object.values(projectModules)
  .map((p: any) => p.frontmatter)
  .sort((a: any, b: any) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 2);
*/
const recentProjects = [];

import NavList from "../../components/NavList.astro";
const currentPath = Astro.url.pathname;

const sections = [
  {
    title: "プロジェクト",
    description: "制作物",
    href: "/ja/projects",
    active: currentPath.startsWith("/notes"),
  },
  {
    title: "興味",
    description: "好きなもの",
    href: "/ja/interests",
    active: currentPath.startsWith("/projects"),
  },
  {
    title: "自己紹介",
    description: "私は誰か？",
    href: "/ja/aboutme",
    active: currentPath.startsWith("/bookshelf"),
  },
];
---

<Base title="Ryo Kato" activeNav="home">
  <section class="mb-1">
    <p
      id="hero-name"
      class="mb-4 text-text text-lg font-bold leading-relaxed transition-opacity duration-200"
    >
      加藤 遼
    </p>

    <!-- Bio -->
    <p class="mb-4 text-text text-lg leading-relaxed">
      <a
        href="https://www.tamu.edu"
        class="text-text underline underline-offset-[3px] decoration-1 hover:text-red transition-colors"
        >テキサスA&M大学</a
      >機械工学科3年生。数学副専攻。現在、テキサス州最大の学生主導ロボット工学団体<a
        href="https://turtlerobotics.org"
        class="text-text underline underline-offset-[3px] decoration-1 hover:text-yellow transition-colors"
        >「TURTLE Robotics」</a
      >の内部担当副代表を務めています。また、<a
        href="https://herc.engr.tamu.edu/"
        class="text-text underline underline-offset-[3px] decoration-1 hover:text-peach transition-colors"
        >「Human-Empowering Robotics and Control（HERC）Lab」</a
      >での研究活動にも協力しています。
    </p>
    <!-- <p class="mb-0 text-[var(--color-subtext1)] leading-relaxed">
      Interested in making tools, thoughtful interfaces, and the craft of software.
    </p> -->
  </section>

  <!-- Social icons row -->
  <div class="flex items-center gap-3 mb-2 mt-0">
    <!-- GitHub -->
    <a
      href="https://github.com/theryokato"
      target="_blank"
      rel="noopener"
      class="social-icon text-subtext0 hover:text-texttransition-colors no-underline"
      data-handle="@theryokato"
      aria-label="GitHub"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
        ></path>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href="https://linkedin.com/in/ryokato-texasam"
      target="_blank"
      rel="noopener"
      class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
      data-handle="/in/ryokato-texasam"
      aria-label="LinkedIn"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
    </a>

    <!-- Twitter (X) -->
    <a
      href="https://x.com/theryokato"
      target="_blank"
      rel="noopener"
      class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
      data-handle="@ryokato"
      aria-label="Twitter"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 14 14"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M11.025.656h2.147L8.482 6.03L14 13.344H9.68L6.294 8.909l-3.87 4.435H.275l5.016-5.75L0 .657h4.43L7.486 4.71zm-.755 11.4h1.19L3.78 1.877H2.504z"
        ></path></svg
      >
    </a>

    <!-- Email -->
    <a
      href="mailto:ryokato@tamu.edu"
      target="_blank"
      rel="noopener"
      class="social-icon text-subtext0 hover:text-text transition-colors no-underline"
      data-handle="ryokato@tamu.edu"
      aria-label="Email"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-2 0l-8 5l-8-5zm0 12H4V8l8 5l8-5z"
        ></path>
      </svg>
    </a>
  </div>

  <br />

  <NavList items={sections} />
</Base>

<script>
  // On hover of any .social-icon, replace the name text temporarily with a fade effect
  const nameElement = document.getElementById("hero-name");
  const originalText = nameElement?.textContent ?? "";

  document.querySelectorAll(".social-icon").forEach((icon) => {
    const handle = (icon as HTMLElement).dataset.handle ?? "";

    icon.addEventListener("mouseenter", () => {
      if (nameElement) {
        nameElement.style.opacity = "0";
        setTimeout(() => {
          nameElement.textContent = handle;
          nameElement.style.opacity = "1";
        }, 150);
      }
    });
    icon.addEventListener("mouseleave", () => {
      if (nameElement) {
        nameElement.style.opacity = "0";
        setTimeout(() => {
          nameElement.textContent = originalText;
          nameElement.style.opacity = "1";
        }, 150);
      }
    });
  });
</script>
