---
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { socials } from "../../constants/socials";
import { homeContent } from "../../content/home/ja";
---

<Base title={homeContent.name} activeNav="home">
  <section class="mb-1">
    <h1
      id="hero-name"
      class="mb-4 text-text text-4xl font-semibold leading-tight tracking-tight whitespace-nowrap transition-opacity duration-200"
    >
      {homeContent.name}
    </h1>

    <p class="text-text text-base leading-relaxed">テキサスA&M大学で機械工学を専攻 · ロボティクス、制御、機械設計</p>
  </section>

  <section id="projects" class="mt-8 scroll-mt-6" aria-labelledby="selected-work">
    <h2 id="selected-work" class="mb-5 text-xl font-semibold text-text">主なプロジェクト</h2>
    <ProjectGrid locale="ja" />
  </section>

  <section class="mt-12" aria-labelledby="about-contact">
    <h2 id="about-contact" class="mb-3 text-xl font-semibold text-text">プロフィール・連絡先</h2>
    {homeContent.bio.map(paragraph => (
      <p class="mb-4 text-text text-lg leading-relaxed" set:html={paragraph} />
    ))}
    <div class="flex items-center gap-3 mt-0">
      {socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener"
          class="social-icon inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm text-subtext0 hover:text-text transition-colors no-underline"
          data-handle={social.handle}
          aria-label={social.platform}
        >
          <svg
            width="25"
            height="25"
            viewBox={social.viewBox}
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={social.svgPath}></path>
          </svg>
        </a>
      ))}
    </div>
  </section>
</Base>

<script src="../../scripts/social-name.ts"></script>
