---
import Base from '../../../layouts/Base.astro';
import MediaList from '../../../components/MediaList.astro';
import { InterestService } from '../../../services/interests';

const items = await InterestService.getBooks('ja');
if (!items) return Astro.redirect('/404');
---

<Base title="本棚" activeNav="interests">
  <h1 class="text-[1.75rem] font-normal leading-tight tracking-tight text-text mb-2">
    本棚
  </h1>
  <p class="font-mono text-xs text-subtext0 mb-10">
    私が読んだ本の不完全なリストです。
  </p>

  <MediaList items={items} />
</Base>
