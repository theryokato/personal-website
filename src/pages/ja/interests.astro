const currentPath = Astro.url.pathname;

const sections = [
  { title: '本棚',    description: '文学のコレクション', href: '/ja/interests/books'},
  { title: '漫画',    description: 'たいていアニメより良い', href: '/ja/interests/manga'},
  { title: 'アニメ',    description: 'たまに漫画を超える', href: '/ja/interests/anime'},
