---
import { preview, previewSet } from "../../../utils/previews";
import Base from "../../../layouts/Base.astro";
import { formatDate } from "../../../utils/dates";

export async function getStaticPaths() {
    const modules = import.meta.glob("../../../content/projects/ja/*.mdx", {
        eager: true,
    }) as Record<string, any>;
    const projects = Object.values(modules);

    const projectPaths = projects
        .filter((proj: any) => !proj.frontmatter.url)
        .map((proj: any) => ({
            params: { slug: proj.frontmatter.slug },
            props: { proj },
        }));

    return projectPaths;
}

const { proj } = Astro.props as any;
const Content = proj.Content;
---

<Base
    title={proj.frontmatter.title}
    description={proj.frontmatter.description}
>
    <a
        href="/ja/#projects"
        class="font-mono text-xs text-subtext0 hover:text-text no-underline mb-8 inline-block transition-colors"
    >
        &larr; プロジェクト一覧へ
    </a>
    {proj.frontmatter.image && (
        <div class="mb-8 rounded-sm overflow-hidden border border-surface0 aspect-16/7">
            <img
                src={preview(proj.frontmatter.image)} srcset={previewSet(proj.frontmatter.image)} sizes="(max-width: 660px) 100vw, 660px" decoding="async"
                alt={proj.frontmatter.title}
                class="w-full h-full object-cover"
            />
        </div>
    )}

    <article>
        <header class="mb-8">
            <h1 class="text-[1.75rem] font-normal leading-tight tracking-tight text-text mb-2">
                {proj.frontmatter.title}
            </h1>
            <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-subtext0">
                <span>
                    {formatDate(proj.frontmatter.startDate, "ja-JP")}
                    {" — "}
                    {formatDate(proj.frontmatter.endDate, "ja-JP")}
                </span>
            </div>
        </header>
        <div class="prose">
            <Content />
        </div>
    </article>
</Base>
