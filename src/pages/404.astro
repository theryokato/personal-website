---
import NotFound from "../components/NotFound.astro";
---
<NotFound />

<script is:inline>
  const path = window.location.pathname;
  if (path.startsWith('/ja/')) {
    window.location.href = '/ja/404';
  } else if (path !== '/404' && path !== '/en/404') {
    window.location.href = '/en/404';
  }
</script>
