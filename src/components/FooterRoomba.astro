<!-- Piixpal 0.4.0, MIT. Keep the original sprite and load only Roomba + its engine. -->
<style is:global>
  /* Keep the mascot above page content and below image zoom overlays. */
  :root { --piix-z: 20; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.querySelector('footer');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let pal;
    let active = true;
    let near = false;
    let library;
    const loadScript = src => new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = resolve;
      script.onerror = () => { script.remove(); reject(new Error('Unable to load Roomba')); };
      document.head.append(script);
    });
    const loadLibrary = () => library ??= loadScript('/vendor/piixpal/0.4.0/core.min.js')
      .then(() => loadScript('/vendor/piixpal/0.4.0/c/roomba.min.js'))
      .catch(error => { library = undefined; throw error; });
    const remove = () => {
      pal?.remove();
      pal = undefined;
    };
    const sync = async () => {
      if (!active || reducedMotion.matches || !near) return remove();
      if (!footer || pal) return;
      try { await loadLibrary(); } catch { return; }
      // Loading can finish after scrolling away, changing preferences, or leaving.
      if (!active || reducedMotion.matches || !near || pal) return;
      pal = document.createElement('piix-pal');
      pal.setAttribute('pal', 'roomba');
      pal.addEventListener('piix:ready', event => {
        const canvas = event.currentTarget.actor.cv;
        canvas.tabIndex = 0;
        canvas.setAttribute('role', 'button');
        canvas.setAttribute('aria-label', document.documentElement.lang === 'ja'
          ? 'ルンバをつつく' : 'Poke the Roomba');
        const root = canvas.getRootNode();
        root.host.removeAttribute('aria-hidden');
        event.currentTarget.actor.bub.setAttribute('aria-hidden', 'true');
        if (!root.querySelector('[data-roomba-focus]')) {
          const style = document.createElement('style');
          style.setAttribute('data-roomba-focus', '');
          style.textContent = 'canvas:focus-visible{outline:2px solid var(--color-focus);outline-offset:3px}';
          root.append(style);
        }
        canvas.addEventListener('keydown', event => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            pal?.dispatchEvent(new CustomEvent('piix:poke', { bubbles: true }));
            pal?.poke();
          }
        });
      }, { once: true });
      footer.append(pal);
    };
    const observer = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
      near = entries[entries.length - 1].isIntersecting;
      void sync();
    }, { rootMargin: '300px 0px' }) : undefined;
    const observe = () => {
      active = true;
      if (!footer) return;
      if (observer) observer.observe(footer);
      else { near = true; void sync(); }
    };
    observe();
    reducedMotion.addEventListener('change', sync);
    window.addEventListener('pagehide', () => {
      active = false;
      near = false;
      observer?.disconnect();
      remove();
    });
    window.addEventListener('pageshow', observe);
  }, { once: true });
</script>
