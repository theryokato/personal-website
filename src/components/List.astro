---
interface Book {
  title: string;
  author: string;
  status: 'reading' | 'finished' | 'partially';
  date: string;       // e.g. "Jul 17, 2025"
  tag?: string;       // optional label that also sets the title color
  year?: number;      // used internally for grouping — no need to set manually
}

const tagColors: Record<string, { text: string; bg: string; border: string }> = {
  Ghibli:     { text: 'var(--color-green)',    bg: 'color-mix(in srgb, var(--color-green) 10%, transparent)',    border: 'color-mix(in srgb, var(--color-green) 30%, transparent)'    },
  "Christopher Nolan":  { text: 'var(--color-lavender)',   bg: 'color-mix(in srgb, var(--color-lavender) 10%, transparent)',   border: 'color-mix(in srgb, var(--color-lavender) 30%, transparent)'   },
  MCU:      { text: 'var(--color-red)',   bg: 'color-mix(in srgb, var(--color-red) 10%, transparent)',   border: 'color-mix(in srgb, var(--color-red) 30%, transparent)'   },
};

interface Props {
  books: Book[];
}

const { books } = Astro.props;

const statusLabel: Record<Book['status'], string> = {
  reading:   'Ongoing',
  finished:  'Finished',
  partially: 'Partially Read',
};

const CUTOFF_YEAR = 2023;

const reading = books.filter(b => b.status === 'reading');
const done    = books.filter(b => b.status !== 'reading');

const byYear = done.reduce<Record<string, Book[]>>((acc, book) => {
  const yr = parseInt(book.date.split(' ').at(-1)!, 10);
  const key = yr < CUTOFF_YEAR ? `Before ${CUTOFF_YEAR}` : String(yr);
  if (!acc[key]) acc[key] = [];
  acc[key].push(book);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => {
  if (a.startsWith('Before')) return 1;
  if (b.startsWith('Before')) return -1;
  return Number(b) - Number(a);
});
---

<div class="book-list">

  {reading.length > 0 && (
    <section class="mb-10">
      <p class="section-label">Currently Reading</p>
      <ul class="book-rows">
        {reading.map(book => (
          <li class="book-row">
            <div class="book-left">
              <span
                class="book-title"
                style={book.tag && tagColors[book.tag] ? `color: ${tagColors[book.tag].text}` : ''}
              >{book.title}</span>
              <div class="book-meta">
                <span class="book-author">{book.author}</span>
                {book.tag && (
                  <span
                    class="book-tag"
                    style={tagColors[book.tag]
                      ? `color:${tagColors[book.tag].text};background:${tagColors[book.tag].bg};border-color:${tagColors[book.tag].border}`
                      : ''}
                  >{book.tag}</span>
                )}
              </div>
            </div>
            <div class="book-right">
              <span class="book-status">{statusLabel[book.status]}</span>
              {/* <span class="book-date">{book.date}</span> */}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {years.map(year => (
    <section class="mb-10">
      <p class="section-label">{year}</p>
      <ul class="book-rows">
        {byYear[year].map(book => (
          <li class="book-row">
            <div class="book-left">
              <span
                class="book-title"
                style={book.tag && tagColors[book.tag] ? `color: ${tagColors[book.tag].text}` : ''}
              >{book.title}</span>
              <div class="book-meta">
                <span class="book-author">{book.author}</span>
                {/* {book.tag && (
                  <span
                    class="book-tag"
                    style={tagColors[book.tag]
                      ? `color:${tagColors[book.tag].text};background:${tagColors[book.tag].bg};border-color:${tagColors[book.tag].border}`
                      : ''}
                  >{book.tag}</span>
                )} */}
              </div>
            </div>
            <div class="book-right">
              <span class="book-status">{statusLabel[book.status]}</span>
              {/* <span class="book-date">{book.date}</span> */}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

</div>

<style>
  .book-list {
    width: 100%;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-subtext0);
    margin-bottom: 0.75rem;
  }

  .book-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .book-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-surface0);
  }

  .book-row:first-child {
    border-top: 1px solid var(--color-surface0);
  }

  .book-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .book-title {
    font-size: 0.9375rem;
    font-weight: medium;
    color: var(--color-text);
    line-height: 1.3;
  }

  .book-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .book-author {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
    line-height: 1.3;
  }

  .book-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    padding: 0.1em 0.5em;
    border-radius: 3px;
    border: 1px solid;
    line-height: 1.6;
    text-transform: lowercase;
  }

  .book-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    white-space: nowrap;
  }

  .book-status {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
  }

  .book-date {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
  }
</style>