---
const { currentLocale } = Astro.props;

// Get current path and create localized versions
const { pathname } = Astro.url;

function getLocalizedPath(targetLocale: string) {
  if (pathname === '/' || pathname === '/en' || pathname === '/en/') {
    return `/${targetLocale}/`;
  }
  if (pathname === '/ja' || pathname === '/ja/') {
    return `/${targetLocale}/`;
  }
  
  // Replace the first occurrence of /en/ or /ja/
  return pathname.replace(/^\/(en|ja)(\/|$)/, `/${targetLocale}$2`);
}

const enPath = getLocalizedPath('en');
const jaPath = getLocalizedPath('ja');
---

<div class="language-picker flex items-center bg-base border border-surface1 rounded-md overflow-hidden font-mono text-xs tracking-widest">
  <a 
    href={enPath} 
    class:list={[
      "flex-1 text-center py-1 px-2 transition-colors border-r border-surface1",
      currentLocale === 'en' 
        ? "bg-text text-base" 
        : "text-subtext0 hover:text-text"
    ]}
    lang="en" hreflang="en"
    aria-current={currentLocale === "en" ? "true" : undefined}
    aria-label="English"
  >
    EN
  </a>
  <a 
    href={jaPath} 
    class:list={[
      "flex-1 text-center py-1 px-2 transition-colors",
      currentLocale === 'ja' 
        ? "bg-text text-base" 
        : "text-subtext0 hover:text-text"
    ]}
    lang="ja" hreflang="ja"
    aria-current={currentLocale === "ja" ? "true" : undefined}
    aria-label="日本語"
  >
    JA
  </a>
</div>

<script is:inline>
  (() => {
    const picker = document.currentScript?.previousElementSibling;
    picker?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0
          || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
          || (link.target && link.target.toLowerCase() !== '_self')
          || link.hasAttribute('download')) return;

        const destination = new URL(link.href);
        if (destination.origin !== window.location.origin) return;

        event.preventDefault();
        if (link.getAttribute('aria-current') === 'true') return;

        // A language choice updates this visit rather than adding a page visit.
        window.location.replace(destination.href);
      });
    });
  })();
</script>
