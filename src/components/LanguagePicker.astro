---
const { currentLocale } = Astro.props;

// Get current path and create localized versions
const { pathname } = Astro.url;

function getLocalizedPath(targetLocale: string) {
  if (pathname === '/' || pathname === '/en' || pathname === '/en/') {
    return `/${targetLocale}/`;
  }
  if (pathname === '/ja' || pathname === '/ja/') {
    return `/${targetLocale}/`;
  }
  
  // Replace the first occurrence of /en/ or /ja/
  return pathname.replace(/^\/(en|ja)(\/|$)/, `/${targetLocale}$2`);
}

const enPath = getLocalizedPath('en');
const jaPath = getLocalizedPath('ja');
---

<div class="language-picker relative flex items-center bg-base border border-surface1 rounded-md overflow-hidden font-mono text-xs tracking-widest">
  <!-- One shared highlight, so a language switch can slide it between options. -->
  <span
    aria-hidden="true"
    class:list={[
      "language-indicator absolute inset-y-0 left-0 w-1/2 bg-text",
      { "translate-x-full": currentLocale === 'ja' },
    ]}
  ></span>
  <a 
    href={enPath} 
    class:list={[
      "relative flex-1 text-center py-1 px-2 transition-colors border-r border-surface1",
      currentLocale === 'en' 
        ? "text-base" 
        : "text-subtext0 hover:text-text"
    ]}
    lang="en" hreflang="en"
    aria-current={currentLocale === "en" ? "true" : undefined}
    aria-label="English"
  >
    EN
  </a>
  <a 
    href={jaPath} 
    class:list={[
      "relative flex-1 text-center py-1 px-2 transition-colors",
      currentLocale === 'ja' 
        ? "text-base" 
        : "text-subtext0 hover:text-text"
    ]}
    lang="ja" hreflang="ja"
    aria-current={currentLocale === "ja" ? "true" : undefined}
    aria-label="日本語"
  >
    JA
  </a>
</div>
