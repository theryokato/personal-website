---
interface Props {
  src: string;
  totalPages: number;
  caption: string;
}

const { src, totalPages, caption } = Astro.props;
---

<figure class="my-8">
  <div
    class="project-slides-container relative group cursor-pointer overflow-hidden rounded-lg bg-surface"
    role="group"
    aria-label={caption}
    data-src={src}
    data-total={totalPages}
  >
    <!-- Canvas for PDF rendering -->
    <div class="relative w-full aspect-video bg-surface flex items-center justify-center">
      <canvas
        class="project-slide-canvas w-full h-full object-contain"
      ></canvas>

      <!-- Loading Indicator -->
      <div class="slide-loader absolute inset-0 flex items-center justify-center bg-surface text-xs font-mono text-text">
        <span role="status">Loading slide...</span>
      </div>
    </div>

    <!-- Counter -->
    <div
      aria-live="polite"
      class="project-slide-counter absolute bottom-3 right-3 z-20 bg-media-overlay text-media-text text-[10px] px-2 py-1 rounded font-mono pointer-events-none"
    >
      1 / {totalPages}
    </div>

    <!-- Navigation Hints -->
    <div class="absolute inset-0 z-20 flex items-center justify-between px-4 pointer-events-none opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
      <button type="button" aria-label="Previous slide" class="prev-slide pointer-events-auto w-8 h-8 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text cursor-pointer hover:bg-media-overlay transition-colors">‹</button>
      <button type="button" aria-label="Next slide" class="next-slide pointer-events-auto w-8 h-8 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text cursor-pointer hover:bg-media-overlay transition-colors">›</button>
    </div>
  </div>
  <figcaption class="mt-2 text-xs text-text font-mono text-center">
    {caption}
  </figcaption>
</figure>

<script>
  // Cache for PDF documents to avoid re-loading the file on every page change
  const pdfCache = new Map();
  let library: Promise<void>;
  function loadLibrary() {
    return library ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/vendor/pdfjs/pdf.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Unable to load PDF viewer'));
      document.head.append(script);
    });
  }

  async function renderPage(container: HTMLElement, pageNum: number) {
    const src = container.getAttribute('data-src');
    const canvasElement = container.querySelector('.project-slide-canvas');
    if (!(canvasElement instanceof HTMLCanvasElement)) return;
    const canvas = canvasElement;
    const loader = container.querySelector('.slide-loader');
    const counter = container.querySelector('.project-slide-counter');

    if (!src || !canvas || !counter) return;

    try {
      loader?.classList.remove('hidden');

      await loadLibrary();
      const pdfjsLib = (window as any).pdfjsLib;
      if (!pdfjsLib) {
        console.error('PDF.js library not loaded');
        return;
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';

      let pdf = pdfCache.get(src);
      if (!pdf) {
        const loadingTask = pdfjsLib.getDocument({ url: src, isEvalSupported: false });
        pdf = await loadingTask.promise;
        pdfCache.set(src, pdf);
      }

      const page = await pdf.getPage(pageNum);

      const viewport = page.getViewport({ scale: 2 });
      const context = canvas.getContext('2d');

      if (!context) return;

      canvas.height = viewport.height;
      canvas.width = viewport.width;

      await page.render({
        canvasContext: context,
        viewport: viewport
      }).promise;

      counter.textContent = `${pageNum} / ${pdf.numPages}`;
    } catch (e) {
      console.error('Error rendering PDF page:', e);
      if (loader) loader.innerHTML = '';
      const link = document.createElement('a');
      link.href = src; link.textContent = 'Open PDF';
      loader?.append(link);
    } finally {
      if (canvas.width > 300) loader?.classList.add('hidden');
    }
  }

  function initSlides() {
    const containers = document.querySelectorAll('.project-slides-container');

    containers.forEach(container => {
      const totalPages = parseInt(container.getAttribute('data-total') || '1');
      let currentIndex = 1;

      let busy = false;
      async function show(index: number) {
        if (busy) return;
        busy = true;
        currentIndex = index;
        await renderPage(container as HTMLElement, currentIndex);
        busy = false;
      }
      void show(1);

      const prevBtn = container.querySelector('.prev-slide');
      const nextBtn = container.querySelector('.next-slide');

      prevBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        await show(currentIndex === 1 ? totalPages : currentIndex - 1);
      });

      nextBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        await show((currentIndex % totalPages) + 1);
      });

      container.addEventListener('click', async () => {
        await show((currentIndex % totalPages) + 1);
      });
    });
  }

  initSlides();
  document.addEventListener('astro:after-swap', initSlides);
</script>
