---
interface Props {
  src: string;
  totalPages: number;
  caption: string;
}

const { src, totalPages, caption } = Astro.props;
---

<figure class="my-8">
  <div
    class="project-slides-container relative group cursor-pointer overflow-hidden rounded-lg bg-surface"
    role="group"
    aria-label={caption}
    data-src={src}
    data-total={totalPages}
  >
    <!-- Canvas for PDF rendering -->
    <div class="relative w-full aspect-video bg-surface flex items-center justify-center">
      <canvas
        class="project-slide-canvas w-full h-full object-contain"
      ></canvas>

      <!-- Loading Indicator -->
      <div class="slide-loader absolute inset-0 flex items-center justify-center bg-surface text-xs font-mono text-text">
        <span role="status">Loading slide...</span>
      </div>
    </div>

    <!-- Counter -->
    <div
      aria-live="polite"
      class="project-slide-counter absolute bottom-3 right-3 z-20 bg-media-overlay text-media-text text-[10px] px-2 py-1 rounded font-mono pointer-events-none"
    >
      1 / {totalPages}
    </div>

    <!-- Navigation Hints -->
    <div class="absolute inset-0 z-20 flex items-center justify-between px-4 pointer-events-none opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
      <button type="button" aria-label="Previous slide" class="prev-slide pointer-events-auto w-8 h-8 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text cursor-pointer hover:bg-media-overlay transition-colors">‹</button>
      <button type="button" aria-label="Next slide" class="next-slide pointer-events-auto w-8 h-8 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text cursor-pointer hover:bg-media-overlay transition-colors">›</button>
    </div>
  </div>
  <figcaption class="mt-2 text-caption text-subtext0 font-mono text-center">
    {caption}
  </figcaption>
</figure>

<script>
  const pdfCache = new Map<string, Promise<any>>();
  const initialized = new WeakSet<Element>();
  let library: Promise<void> | undefined;
  let worker: any;

  function loadLibrary() {
    return library ??= new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/vendor/pdfjs/pdf.min.js';
      script.onload = () => resolve();
      script.onerror = () => {
        script.remove();
        library = undefined;
        reject(new Error('Unable to load PDF viewer'));
      };
      document.head.append(script);
    });
  }

  async function documentFor(src: string) {
    await loadLibrary();
    const lib = (window as any).pdfjsLib;
    lib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
    // Every presentation on this page shares the same worker and initialization.
    const currentWorker = worker ??= new lib.PDFWorker();
    try {
      await currentWorker.promise;
    } catch (error) {
      if (worker === currentWorker) {
        worker = undefined;
        // PDF.js also caches failed fake-worker initialization; reload only on failure.
        library = undefined;
        currentWorker.destroy();
      }
      throw error;
    }
    let pdf = pdfCache.get(src);
    if (!pdf) {
      pdf = lib.getDocument({ url: src, worker: currentWorker, isEvalSupported: false }).promise;
      pdfCache.set(src, pdf!);
      pdf!.catch(() => pdfCache.delete(src));
    }
    return pdf;
  }

  const pixelWidth = (container: HTMLElement) =>
    Math.max(1, Math.ceil(container.clientWidth * (window.devicePixelRatio || 1)));

  async function renderPage(container: HTMLElement, pageNum: number) {
    const src = container.dataset.src;
    const canvas = container.querySelector('canvas');
    const loader = container.querySelector('.slide-loader');
    const counter = container.querySelector('.project-slide-counter');
    if (!src || !canvas || !counter) return 0;
    loader?.classList.remove('hidden');
    try {
      const pdf = await documentFor(src);
      const page = await pdf.getPage(pageNum);
      const viewport = page.getViewport({ scale: pixelWidth(container) / page.getViewport({ scale: 1 }).width });
      const context = canvas.getContext('2d');
      if (!context) throw new Error('Unable to create slide canvas');
      canvas.width = Math.ceil(viewport.width);
      canvas.height = Math.ceil(viewport.height);
      await page.render({ canvasContext: context, viewport }).promise;
      counter.textContent = `${pageNum} / ${pdf.numPages}`;
      loader?.classList.add('hidden');
      return canvas.width;
    } catch (error) {
      console.error('Error rendering PDF page:', error);
      const link = document.createElement('a');
      link.href = src;
      link.textContent = 'Open PDF';
      loader?.replaceChildren(link);
      return 0;
    }
  }

  function initSlides() {
    const observer = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) {
        observer?.unobserve(entry.target);
        entry.target.dispatchEvent(new Event('slides:near'));
      }
    }, { rootMargin: '300px 0px' }) : undefined;

    document.querySelectorAll<HTMLElement>('.project-slides-container').forEach(container => {
      if (initialized.has(container)) return;
      initialized.add(container);
      const totalPages = parseInt(container.dataset.total || '1');
      let currentIndex = 1;
      let started = false;
      let busy = false;
      let renderedWidth = 0;
      let resizeTimer: ReturnType<typeof setTimeout>;
      let pendingResize = false;

      async function show(index: number) {
        if (busy) return;
        started = true;
        busy = true;
        currentIndex = index;
        renderedWidth = await renderPage(container, currentIndex);
        busy = false;
        if (pendingResize) {
          pendingResize = false;
          if (renderedWidth && pixelWidth(container) !== renderedWidth) void show(currentIndex);
        }
      }

      container.addEventListener('slides:near', () => { if (!started) void show(1); }, { once: true });
      if (observer) observer.observe(container);
      else void show(1);

      if ('ResizeObserver' in window) new ResizeObserver(() => {
        if (!started || pixelWidth(container) === renderedWidth) return;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (busy) pendingResize = true;
          else void show(currentIndex);
        }, 120);
      }).observe(container);

      container.querySelector('.prev-slide')?.addEventListener('click', event => {
        event.stopPropagation();
        void show(currentIndex === 1 ? totalPages : currentIndex - 1);
      });
      container.querySelector('.next-slide')?.addEventListener('click', event => {
        event.stopPropagation();
        void show((currentIndex % totalPages) + 1);
      });
      container.addEventListener('click', event => {
        if ((event.target as Element).closest('a')) return;
        void show((currentIndex % totalPages) + 1);
      });
    });
  }

  initSlides();
  document.addEventListener('astro:after-swap', initSlides);
</script>
