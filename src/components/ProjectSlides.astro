---
import { slides } from "../utils/previews";

interface Props {
  /** The PDF; `npm run previews` exports its pages to per-slide images. */
  src: string;
  totalPages: number;
  caption: string;
}

const { src, totalPages, caption } = Astro.props;
const ja = Astro.currentLocale === 'ja';
const labels = ja
  ? { deck: 'スライド', previous: '前のスライド', next: '次のスライド', enter: '全画面表示', exit: '全画面表示を終了', slide: 'スライド {n} / {total}', pdf: 'PDFを開く' }
  : { deck: 'slide deck', previous: 'Previous slide', next: 'Next slide', enter: 'Enter full screen', exit: 'Exit full screen', slide: 'Slide {n} of {total}', pdf: 'Open PDF' };
const slideAlt = (n: number) => `${caption}: ${labels.slide.replace('{n}', `${n}`).replace('{total}', `${totalPages}`)}`;
---

<figure class="my-8">
  <div
    class="project-slides-container relative group cursor-pointer overflow-hidden rounded-lg bg-surface touch-pan-y touch-pinch-zoom"
    role="group"
    aria-roledescription={labels.deck}
    aria-label={caption}
    tabindex="0"
    data-slides={slides(src)}
    data-total={totalPages}
    data-alt={`${caption}: ${labels.slide}`}
    data-enter-label={labels.enter}
    data-exit-label={labels.exit}
  >
    <div class="slide-stage relative w-full aspect-video bg-surface">
      <img
        src={`${slides(src)}1.webp`}
        alt={slideAlt(1)}
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
        class="project-slide-image absolute inset-0 w-full h-full object-contain"
      />
    </div>

    <!-- Counter -->
    <div
      aria-live="polite"
      class="project-slide-counter absolute bottom-3 right-3 z-20 bg-media-overlay text-media-text text-[10px] px-2 py-1 rounded font-mono pointer-events-none"
    >
      1 / {totalPages}
    </div>

    <!-- Navigation Hints -->
    <div class="slide-controls absolute inset-0 z-20 flex items-center justify-between px-1.5 sm:px-3 pointer-events-none opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
      <button type="button" aria-label={labels.previous} class="prev-slide pointer-events-auto w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text text-lg cursor-pointer hover:bg-media-overlay transition-colors">‹</button>
      <button type="button" aria-label={labels.next} class="next-slide pointer-events-auto w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text text-lg cursor-pointer hover:bg-media-overlay transition-colors">›</button>
      <button type="button" aria-label={labels.enter} hidden class="fullscreen-slide pointer-events-auto absolute top-1.5 right-1.5 sm:top-3 sm:right-3 w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-media-overlay/90 text-media-text cursor-pointer hover:bg-media-overlay transition-colors">
        <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
        </svg>
      </button>
    </div>
  </div>
  <figcaption class="mt-2 text-caption text-subtext0 font-mono text-center">
    {caption} · <a href={src} target="_blank" rel="noopener" class="underline underline-offset-[3px] decoration-1 hover:text-text">{labels.pdf}</a>
  </figcaption>
</figure>

<script>
  const initialized = new WeakSet<Element>();

  function initSlides() {
    document.querySelectorAll<HTMLElement>('.project-slides-container').forEach(container => {
      if (initialized.has(container)) return;
      initialized.add(container);
      const image = container.querySelector<HTMLImageElement>('.project-slide-image');
      const counter = container.querySelector('.project-slide-counter');
      if (!image || !counter) return;
      const base = container.dataset.slides ?? '';
      const totalPages = parseInt(container.dataset.total || '1');
      const altTemplate = container.dataset.alt ?? '';
      const url = (index: number) => `${base}${index}.webp`;
      const wrap = (index: number) => ((index - 1 + totalPages) % totalPages) + 1;
      let currentIndex = 1;

      // Warm the neighbours so the next click shows its slide immediately.
      const preloaded = new Set<number>();
      const preload = (index: number) => {
        if (preloaded.has(index)) return;
        preloaded.add(index);
        new Image().src = url(index);
      };

      function show(index: number) {
        currentIndex = wrap(index);
        // The current slide stays painted until the new image has loaded.
        image!.src = url(currentIndex);
        image!.alt = altTemplate.replace('{n}', `${currentIndex}`).replace('{total}', `${totalPages}`);
        counter!.textContent = `${currentIndex} / ${totalPages}`;
        preload(wrap(currentIndex + 1));
        preload(wrap(currentIndex - 1));
      }

      const previous = () => show(currentIndex - 1);
      const next = () => show(currentIndex + 1);

      // Only fetch slide 2 once the deck is close to view, never on page load.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          preload(2);
        }, { rootMargin: '200px 0px' });
        observer.observe(container);
      }

      container.querySelector('.prev-slide')?.addEventListener('click', event => {
        event.stopPropagation();
        previous();
      });
      container.querySelector('.next-slide')?.addEventListener('click', event => {
        event.stopPropagation();
        next();
      });

      // Horizontal swipes page through touch devices; vertical scrolling stays native.
      let swipeStart: { x: number; y: number } | undefined;
      let swiped = false;
      container.addEventListener('pointerdown', event => {
        swiped = false;
        swipeStart = event.pointerType === 'mouse' ? undefined : { x: event.clientX, y: event.clientY };
      });
      container.addEventListener('pointerup', event => {
        if (!swipeStart) return;
        const dx = event.clientX - swipeStart.x;
        const dy = event.clientY - swipeStart.y;
        swipeStart = undefined;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        swiped = true;
        if (dx < 0) next();
        else previous();
      });
      container.addEventListener('pointercancel', () => { swipeStart = undefined; });

      container.addEventListener('click', event => {
        if (swiped) {
          swiped = false;
          return;
        }
        if ((event.target as Element).closest('a, button')) return;
        next();
      });

      container.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') next();
        else if (event.key === 'ArrowLeft') previous();
        else return;
        event.preventDefault();
      });

      const fullscreen = container.querySelector<HTMLButtonElement>('.fullscreen-slide');
      if (fullscreen && document.fullscreenEnabled) {
        fullscreen.hidden = false;
        fullscreen.addEventListener('click', event => {
          event.stopPropagation();
          if (document.fullscreenElement === container) void document.exitFullscreen();
          else void container.requestFullscreen().then(() => container.focus());
        });
        document.addEventListener('fullscreenchange', () => {
          fullscreen.setAttribute('aria-label', (document.fullscreenElement === container
            ? container.dataset.exitLabel : container.dataset.enterLabel) ?? '');
        });
      }
    });
  }

  initSlides();
  document.addEventListener('astro:after-swap', initSlides);
</script>
