---
import type { MediaItem } from '../types/interests';

interface Props {
  items: MediaItem[];
  showDetailedStatus?: boolean;
  showAuthorOnRight?: boolean;
}

const { items, showDetailedStatus = false, showAuthorOnRight = false } = Astro.props;

const statusLabels: Record<string, Record<MediaItem['status'], string>> = {
  en: {
    reading:   'Ongoing',
    finished:  'Finished',
    partially: 'Partially Read',
    abandoned: 'Abandoned',
  },
  ja: {
    reading:   '読書中',
    finished:  '読了',
    partially: '一部読了',
    abandoned: '断念',
  },
};

const locale = Astro.currentLocale || 'en';
const statusLabel = statusLabels[locale] || statusLabels.en;

const reading = items.filter(b => b.status === 'reading');

let finished: MediaItem[] = [];
let others: MediaItem[] = [];
let done: MediaItem[] = [];

if (showDetailedStatus) {
  finished = items.filter(b => b.status === 'finished');
  others = items.filter(b => b.status === 'abandoned' || b.status === 'partially');
} else {
  done = items.filter(b => b.status !== 'reading');
}
---

<div class="book-list">

  {reading.length > 0 && (
    <section class="mb-10">
      <p class="section-label">Currently Reading</p>
      <ul class="book-rows">
        {reading.map(book => (
          <li class="book-row">
            <div class="book-left">
              <span class="book-title">{book.title}</span>
              <div class="book-meta">
                {!showAuthorOnRight && book.author && <span class="book-author">{book.author}</span>}
              </div>
            </div>
            <div class="book-right">
              {showAuthorOnRight && book.author ? (
                <span class="book-author">{book.author}</span>
              ) : (
                <span class="book-status">{statusLabel[book.status]}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {showDetailedStatus ? (
    <>
      {finished.length > 0 && (
        <section class="mb-10">
          <p class="section-label">Finished</p>
          <ul class="book-rows">
            {finished.map(book => (
              <li class="book-row">
                <div class="book-left">
                  <span class="book-title">{book.title}</span>
                  <div class="book-meta">
                    {!showAuthorOnRight && book.author && <span class="book-author">{book.author}</span>}
                  </div>
                </div>
                <div class="book-right">
                  {showAuthorOnRight && book.author ? (
                    <span class="book-author">{book.author}</span>
                  ) : (
                    <span class="book-status">{statusLabel[book.status]}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
      {others.length > 0 && (
        <section class="mb-10">
          <p class="section-label">Paused/Abandoned</p>
          <ul class="book-rows">
            {others.map(book => (
              <li class="book-row">
                <div class="book-left">
                  <span class="book-title">{book.title}</span>
                  <div class="book-meta">
                    {!showAuthorOnRight && book.author && <span class="book-author">{book.author}</span>}
                  </div>
                </div>
                <div class="book-right">
                  {showAuthorOnRight && book.author ? (
                    <span class="book-author">{book.author}</span>
                  ) : (
                    <span class="book-status">{statusLabel[book.status]}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  ) : (
    done.length > 0 && (
      <section class="mb-10">
        <p class="section-label">Finished / Others</p>
        <ul class="book-rows">
          {done.map(book => (
            <li class="book-row">
              <div class="book-left">
                <span class="book-title">{book.title}</span>
                <div class="book-meta">
                  {!showAuthorOnRight && book.author && <span class="book-author">{book.author}</span>}
                </div>
              </div>
              <div class="book-right">
                {showAuthorOnRight && book.author ? (
                  <span class="book-author">{book.author}</span>
                ) : (
                  <span class="book-status">{statusLabel[book.status]}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  )}

</div>

<style>
  .book-list {
    width: 100%;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-subtext0);
    margin-bottom: 0.75rem;
  }

  .book-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .book-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-surface0);
  }

  .book-row:first-child {
    border-top: 1px solid var(--color-surface0);
  }

  .book-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .book-title {
    font-size: 0.9375rem;
    font-weight: medium;
    color: var(--color-text);
    line-height: 1.3;
  }

  .book-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .book-author {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
    line-height: 1.3;
  }

  .book-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    white-space: nowrap;
  }

  .book-status {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
  }
</style>
