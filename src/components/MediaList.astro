---
import type { MediaItem } from '../types/interests';

interface Props {
  items: MediaItem[];
  showDetailedStatus?: boolean;
  showAuthorOnRight?: boolean;
}

const { items, showDetailedStatus = false, showAuthorOnRight = false } = Astro.props;

const reading = items.filter(item => item.status === 'reading');

let finished: MediaItem[] = [];
let others: MediaItem[] = [];
let done: MediaItem[] = [];

if (showDetailedStatus) {
  finished = items.filter(item => item.status === 'finished');
  others = items.filter(item => item.status === 'abandoned' || item.status === 'partially');
} else {
  done = items.filter(item => item.status !== 'reading');
}
---

<div class="media-list">

  {reading.length > 0 && (
    <section class="mb-10">
      <p class="section-label">Currently Reading</p>
      <ul class="media-rows">
        {reading.map(item => (
          <li class="media-row">
            <div class="media-left">
              <span class="media-title">{item.title}</span>
              <div class="media-meta">
                {!showAuthorOnRight && item.author && <span class="media-author">{item.author}</span>}
              </div>
            </div>
            <div class="media-right">
              {showAuthorOnRight && item.author ? (
                <span class="media-author">{item.author}</span>
              ) : null}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {showDetailedStatus ? (
    <>
      {finished.length > 0 && (
        <section class="mb-10">
          <p class="section-label">Finished</p>
          <ul class="media-rows">
            {finished.map(item => (
              <li class="media-row">
                <div class="media-left">
                  <span class="media-title">{item.title}</span>
                  <div class="media-meta">
                    {!showAuthorOnRight && item.author && <span class="media-author">{item.author}</span>}
                  </div>
                </div>
                <div class="media-right">
                  {showAuthorOnRight && item.author ? (
                    <span class="media-author">{item.author}</span>
                  ) : null}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
      {others.length > 0 && (
        <section class="mb-10">
          <p class="section-label">Paused/Abandoned</p>
          <ul class="media-rows">
            {others.map(item => (
              <li class="media-row">
                <div class="media-left">
                  <span class="media-title">{item.title}</span>
                  <div class="media-meta">
                    {!showAuthorOnRight && item.author && <span class="media-author">{item.author}</span>}
                  </div>
                </div>
                <div class="media-right">
                  {showAuthorOnRight && item.author ? (
                    <span class="media-author">{item.author}</span>
                  ) : null}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  ) : (
    done.length > 0 && (
      <section class="mb-10">
        <p class="section-label">Finished / Others</p>
        <ul class="media-rows">
          {done.map(item => (
            <li class="media-row">
              <div class="media-left">
                <span class="media-title">{item.title}</span>
                <div class="media-meta">
                  {!showAuthorOnRight && item.author && <span class="media-author">{item.author}</span>}
                </div>
              </div>
              <div class="media-right">
                {showAuthorOnRight && item.author ? (
                  <span class="media-author">{item.author}</span>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  )}

</div>

<style>
  .media-list {
    width: 100%;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-subtext0);
    margin-bottom: 0.75rem;
  }

  .media-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .media-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-surface0);
  }

  .media-row:first-child {
    border-top: 1px solid var(--color-surface0);
  }

  .media-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .media-title {
    font-size: 0.9375rem;
    font-weight: medium;
    color: var(--color-text);
    line-height: 1.3;
  }

  .media-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .media-author {
    font-size: 0.8125rem;
    color: var(--color-subtext0);
    line-height: 1.3;
  }

  .media-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    white-space: nowrap;
  }
</style>
