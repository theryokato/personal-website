---
import { preview, previewSet } from "../utils/previews";
import { formatDate } from "../utils/dates";

interface Props {
  locale: 'en' | 'ja';
}

interface Project {
  slug: string;
  title: string;
  image?: string;
  startDate?: string;
  endDate?: string;
  url?: string;
}

const { locale } = Astro.props;
const en = import.meta.glob("../content/projects/en/*.mdx", { eager: true });
const ja = import.meta.glob("../content/projects/ja/*.mdx", { eager: true });
const modules = (locale === 'ja' ? ja : en) as Record<string, { frontmatter: Project }>;
const projects = Object.values(modules)
  .map(module => module.frontmatter)
  .sort((a, b) => (b.startDate ?? "").localeCompare(a.startDate ?? ""));
const dateLocale = locale === 'ja' ? 'ja-JP' : 'en-US';
---

<div class="grid grid-cols-2 gap-5 mt-4">
    {projects.map((p: any) => (
        <a
            href={p.url || `/${locale}/projects/${p.slug}`}
            target={p.url ? "_blank" : undefined}
            rel={p.url ? "noopener noreferrer" : undefined}
            class="group no-underline block"
        >
            <div class="overflow-hidden rounded-sm bg-mantle aspect-4/3 mb-2">
                {p.image ? (
                    <img
                        src={preview(p.image)} srcset={previewSet(p.image)} sizes="(max-width: 600px) 45vw, 310px" loading="lazy" decoding="async"
                        alt={p.title}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-150"
                    />
                ) : (
                    <div class="w-full h-full bg-surface0" />
                )}
            </div>
            <div class="project-summary flex items-baseline justify-between gap-2">
                <span class="text-sm text-text leading-snug truncate">
                    {p.title}
                </span>
                <span class="font-mono text-xs text-subtext0 whitespace-nowrap">
                    {formatDate(p.startDate, dateLocale)}
                    {" — "}
                    {formatDate(p.endDate, dateLocale)}
                </span>
            </div>
        </a>
    ))}
</div>
