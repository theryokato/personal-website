---
import { preview, previewSet } from "../utils/previews";
import { formatDate } from "../utils/dates";
import { projectsFor } from "../utils/projects";

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const projects = projectsFor(locale);
const dateLocale = locale === 'ja' ? 'ja-JP' : 'en-US';
---

<div class="grid grid-cols-1 min-[601px]:grid-cols-2 gap-5">
    {projects.map(p => (
        <a
            href={p.url || `/${locale}/projects/${p.slug}`}
            target={p.url ? "_blank" : undefined}
            rel={p.url ? "noopener noreferrer" : undefined}
            class="group no-underline block"
        >
            <div class="overflow-hidden rounded-sm bg-mantle aspect-4/3 mb-2" data-project-media={p.url ? undefined : p.slug}>
                {p.image ? (
                    <img
                        src={preview(p.image)} srcset={previewSet(p.image)} sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 45rem) calc(50vw - 2.125rem), 20.375rem" loading="lazy" decoding="async"
                        alt={p.title}
                        class="project-preview w-full h-full object-cover"
                    />
                ) : (
                    <div class="w-full h-full bg-surface-secondary" />
                )}
            </div>
            <div class="project-summary flex flex-col items-start gap-0.5">
                <span class="text-sm font-medium text-text leading-5 break-words">
                    {p.title}
                </span>
                <span class="font-mono text-xs leading-[1.5] text-subtext0 whitespace-nowrap">
                    {formatDate(p.startDate, dateLocale)}
                    {" — "}
                    {formatDate(p.endDate, dateLocale)}
                </span>
            </div>
        </a>
    ))}
</div>
