---
import { preview, previewSet } from "../utils/previews";
interface Props {
  src: string;
  alt?: string;
  caption: string;
  width: number;
  height: number;
  paper?: boolean;
}

const { src, alt, caption, width, height, paper = false } = Astro.props;
const finalAlt = alt ?? caption;
---

<figure class="my-8">
  <a
    href={src}
    data-project-image
    data-project-paper={paper ? "" : undefined}
    data-pswp-width={width}
    data-pswp-height={height}
    data-pswp-caption={caption}
    aria-label={`Open full-size image: ${finalAlt}`}
    class="block cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-blue"
  >
    <img
      src={preview(src)}
      srcset={previewSet(src)}
      sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 45rem) calc(100vw - 3rem), 42rem"
      loading="lazy"
      decoding="async"
      alt={finalAlt}
      width={width}
      height={height}
      class:list={["w-full h-auto block", { "project-image-paper": paper }]}
    />
  </a>
  <figcaption class="mt-2 text-caption text-subtext0 font-mono text-center">
    {caption}
  </figcaption>
</figure>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.prose',
    children: 'a[data-project-image]',
    pswpModule: () => import('photoswipe'),
    showAnimationDuration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 150,
    hideAnimationDuration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 150,
  });

  lightbox.on('contentAppend', ({ content }) => {
    if (content.data.element?.hasAttribute('data-project-paper')) {
      content.element?.classList.add('project-image-paper');
    }
  });

  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'project-caption',
      className: 'pswp__project-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (element, pswp) => {
        const updateCaption = () => {
          element.textContent =
            pswp.currSlide?.data.element?.dataset.pswpCaption ?? '';
        };

        updateCaption();
        pswp.on('change', updateCaption);
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .pswp__project-caption {
    bottom: 1rem;
    color: var(--color-media-text);
    background-color: var(--color-media-overlay);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    left: 50%;
    max-width: min(90vw, 42rem);
    padding: 0.5rem 0.75rem;
    position: absolute;
    text-align: center;
    transform: translateX(-50%);
  }
</style>
