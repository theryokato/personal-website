---
interface Props {
  src: string;
  alt?: string;
  caption: string;
  width: number;
  height: number;
}

const { src, alt, caption, width, height } = Astro.props;
const finalAlt = alt ?? caption;
---

<figure class="my-8">
  <a
    href={src}
    data-project-image
    data-pswp-width={width}
    data-pswp-height={height}
    data-pswp-caption={caption}
    aria-label={`Open full-size image: ${finalAlt}`}
    class="block cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-blue"
  >
    <img
      src={src}
      alt={finalAlt}
      width={width}
      height={height}
      class="w-full h-auto block"
    />
  </a>
  <figcaption class="mt-2 text-xs text-text font-mono text-center">
    {caption}
  </figcaption>
</figure>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.prose',
    children: 'a[data-project-image]',
    pswpModule: () => import('photoswipe'),
  });

  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'project-caption',
      className: 'pswp__project-caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (element, pswp) => {
        const updateCaption = () => {
          element.textContent =
            pswp.currSlide?.data.element?.dataset.pswpCaption ?? '';
        };

        updateCaption();
        pswp.on('change', updateCaption);
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .pswp__project-caption {
    bottom: 1rem;
    color: white;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    left: 50%;
    max-width: min(90vw, 42rem);
    padding: 0.5rem 0.75rem;
    position: absolute;
    text-align: center;
    transform: translateX(-50%);
  }
</style>
