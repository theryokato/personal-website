---
interface Props {
  src?: string;
  alt?: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
const finalAlt = alt ?? caption;
---

{src && (
  <figure class="my-8">
    <img
      src={src}
      alt={finalAlt}
      class="w-full h-auto block"
    />
    <figcaption class="mt-2 text-xs text-text font-mono text-center">
      {caption}
    </figcaption>
  </figure>
)}
